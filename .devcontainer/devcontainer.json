{
  "name": "ChurnBuster Dev Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    /* Docker-in-Docker is still needed for Airflow */
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "true"
    },
    /* Terraform is stable, so we keep it as a feature */
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "ms-python.python",
        "googlecloudtools.cloudcode",
        "mechatroner.rainbow-csv"
      ]
    }
  },
  "postCreateCommand": "echo 'Environment Ready!'"
}